# Copy this file to .env and fill it in. .env is gitignored and never committed.
#
#     cp .env.example .env
#
# docker compose reads .env automatically from this directory.

# Postgres. These three feed both the database container and DATABASE_URL below,
# so if you change one, change it everywhere.
POSTGRES_DB=cadence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# How the backend reaches Postgres. "postgres" is the service name in
# docker-compose.yml, not localhost — inside the network, that's the hostname.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/cadence

# Set to 1 only when serving over HTTPS; the cookie won't be sent over plain HTTP.
SESSION_COOKIE_SECURE=0

# The key that hashes stored sign-in tokens. The app won't start without one, refuses this dev
# key over HTTPS, and changing it signs everyone out. Make a real one with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
TOKEN_HASH_KEY=dev-only-token-hash-key
# To change the key without signing everyone out, put the old one here for 30 days.
TOKEN_HASH_OLD_KEYS=

# Logs. "text" reads well in a terminal; leave it out to get JSON, as on Render.
LOG_FORMAT=text
LOG_LEVEL=INFO

# Metrics and logs to Grafana Cloud, from its OpenTelemetry connection page. Left empty,
# nothing is sent.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# AI card generation. "fake" returns sample cards without contacting a vendor, so no key is
# needed. Set it to "gemini" and fill in GEMINI_API_KEY to use the real model.
AI_WRITER_PROVIDER=fake
AI_WRITER_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# The judge checks and repairs each batch (up to 8 model calls a request, including a search).
# AI_JUDGE_PROVIDER=gemini
# AI_JUDGE_MODEL=gemini-3.8-flash
# The high-volume calls: tutor chat, file screening, topic suggestions and the same-fact check.
# AI_HELPER_PROVIDER=gemini
# AI_HELPER_MODEL=gemini-3.5-flash-lite
# Each role's fallbacks, in order, as "vendor:model,vendor:model", used once a model's daily
# limit is reached.
# AI_WRITER_FALLBACKS=gemini:gemini-3.1-flash-lite
# AI_JUDGE_FALLBACKS=gemini:gemini-3.7-flash,gemini:gemini-3.6-flash,gemini:gemini-3.5-flash,gemini:gemini-3.5-flash-lite,gemini:gemini-3.1-flash-lite
# AI_HELPER_FALLBACKS=gemini:gemini-3.5-flash-lite
# Turns uploaded files into searchable vectors. After changing the model, run
# `python -m app.cli reindex`, because search only reads vectors from the current one.
# AI_EMBEDDER_PROVIDER=gemini
# AI_EMBEDDER_MODEL=gemini-embedding-001
# How hard each Gemini role's model thinks. Higher is slower.
# AI_WRITER_THINKING=low
# AI_JUDGE_THINKING=low
# In any 24 hours: generations per user, and calls per model across all features. The defaults
# come from third-party figures, so confirm your real limits in AI Studio. Unlisted models get
# AI_MODEL_DAILY_LIMIT.
# AI_DAILY_LIMIT=10
# AI_MODEL_DAILY_LIMIT=18
# Calls per model per minute across all workers. Set these to your API plan's limits.
# AI_MODEL_RATE_LIMITS=gemini-3.5-flash-lite:15,gemini-3.8-flash:10,gemini-embedding-001:100
# AI_MODEL_DAILY_LIMITS=gemini-3.5-flash-lite:450,gemini-3.8-flash:18,gemini-embedding-001:900
# The deck tutor. Calls in any 24 hours: for the whole site and per learner. "false" turns it off.
# AI_TUTOR_ENABLED=true
# AI_TUTOR_DAILY_LIMIT=100
# AI_TUTOR_USER_DAILY_LIMIT=20
# Background card reviews. Calls in any 24 hours: for the whole site and per learner. The reserve
# is how many calls per model they leave for learners' own requests. "false" turns them off.
# AI_PROBLEM_CARDS_ENABLED=true
# AI_PROBLEM_CARDS_DAILY_LIMIT=10
# AI_PROBLEM_CARDS_USER_DAILY_LIMIT=4
# AI_PROBLEM_CARDS_MODEL_RESERVE=9
# Sends every AI run, with its prompts and replies, to LangSmith for debugging.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=cadence

