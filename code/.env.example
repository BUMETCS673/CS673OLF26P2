# Copy this file to .env and fill it in. .env is gitignored and never committed.
#
#     cp .env.example .env
#
# docker compose reads .env automatically from this directory.

# Signs the session cookie. Any long random string will do for local development;
# generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Postgres. These three feed both the database container and DATABASE_URL below,
# so if you change one, change it everywhere.
POSTGRES_DB=cadence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# How the backend reaches Postgres. "postgres" is the service name in
# docker-compose.yml, not localhost — inside the network, that's the hostname.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/cadence

# Set to 1 only when serving over HTTPS; the cookie won't be sent over plain HTTP.
SESSION_COOKIE_SECURE=0

# AI card generation. "fake" returns sample cards without contacting Google, so no key is
# needed. Set it to "gemini" and fill in GEMINI_API_KEY to use the real model.
AI_WRITER_PROVIDER=fake
AI_WRITER_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# "graph" checks and repairs each batch (up to 5 model calls a request, plus 4 for a long file), on AI_JUDGE_MODEL.
# AI_PIPELINE=single
# AI_JUDGE_PROVIDER=gemini
# AI_JUDGE_MODEL=gemini-3.8-flash
# How hard each role's model thinks. Higher is slower.
# AI_WRITER_THINKING=low
# AI_JUDGE_THINKING=low
# In any 24 hours: generations per user, and calls per model across all features. The defaults
# come from third-party figures, so confirm your real limits in AI Studio. Unlisted models get
# AI_MODEL_DAILY_LIMIT.
# AI_DAILY_LIMIT=10
# AI_MODEL_DAILY_LIMIT=18
# AI_MODEL_DAILY_LIMITS=gemini-3.5-flash-lite:450,gemini-3.8-flash:18
# The deck tutor. Calls in any 24 hours: for the whole site and per learner. "false" turns it off.
# AI_TUTOR_ENABLED=true
# AI_TUTOR_DAILY_LIMIT=100
# AI_TUTOR_USER_DAILY_LIMIT=20
# Background card reviews. Calls in any 24 hours: for the whole site and per learner. The reserve
# is how many calls per model they leave for learners' own requests. "false" turns them off.
# AI_LEECH_ENABLED=true
# AI_LEECH_DAILY_LIMIT=10
# AI_LEECH_USER_DAILY_LIMIT=4
# AI_LEECH_MODEL_RESERVE=9

# Flask's interactive debugger runs arbitrary code for anyone who can reach the port.
# Only for `python wsgi.py` outside Docker; never enable where the port is reachable.
# FLASK_DEBUG=1
