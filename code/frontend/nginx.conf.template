# Serves the built SPA and forwards /api to Flask.
#
# Same idea as the Vite dev proxy (decision D4): the browser only ever sees one origin,
# so there's no CORS to configure and the session cookie is sent on every API call.
# ${API_ORIGIN} and ${PORT} are substituted at container start -- the compose service in
# dev, the backend service's internal URL and the assigned port on Render.

server {
    # Substituted at container start: 8080 by default, whatever the host assigns on Render.
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Don't advertise the exact nginx version to anyone scanning.
    server_tokens off;

    location /api/ {
        proxy_pass ${API_ORIGIN};

        proxy_http_version 1.1;
        # The backend's own host, from proxy_pass. On Render, API_ORIGIN is the backend's
        # public https address, and Render routes by Host: the visitor's $host (this
        # frontend) would send the request straight back here. SNI does the same job for
        # the TLS handshake. Both are harmless locally, where API_ORIGIN is plain http.
        proxy_set_header Host              $proxy_host;
        proxy_ssl_server_name on;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # A cold free-tier backend can take a while to wake up.
        proxy_connect_timeout 30s;
        proxy_read_timeout    60s;

        # nginx's default is 1 MB, which would refuse a file upload for AI generation
        # before Flask ever saw it. 6 MB fits a 4 MB file once it's base64 in JSON.
        # Flask still holds every other route to 1 MB (MAX_CONTENT_LENGTH).
        client_max_body_size 6m;
    }

    # Vite fingerprints these filenames, so a given URL's contents never change.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Client-side routing: /decks/3 is a React route, not a file on disk, so anything
    # that isn't a real file has to come back as index.html rather than a 404.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html itself must never be cached, or browsers keep loading the old bundle
    # after a deploy.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }
}
