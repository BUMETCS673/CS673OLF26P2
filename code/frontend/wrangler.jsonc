// The Cloudflare Worker that serves the built frontend and forwards the API to the backend.
// It replaces the nginx container on Render. CD deploys it with `wrangler deploy`.
{
  "name": "cadence",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-24",
  "assets": {
    // What `npm run build` produces. Files here are served without running the Worker.
    "directory": "./dist",
    // Lets the Worker hand a request back to the static files with env.ASSETS.fetch
    "binding": "ASSETS",
    // React routes such as /decks/3 aren't files, so they get index.html
    "not_found_handling": "single-page-application",
    // Paths that run the Worker before any file lookup. The globs are a little wide, and
    // the Worker checks the exact paths itself.
    "run_worker_first": [
      "/api/*",
      "/authorize*",
      "/token*",
      "/register*",
      "/revoke*",
      "/.well-known/oauth-*"
    ]
  }
  // API_ORIGIN, the backend's https address, is passed in at deploy time with
  // `--var API_ORIGIN:...` so the address stays out of the repo. For `wrangler dev`,
  // put API_ORIGIN=... in a .dev.vars file next to this one.
}
